# ── Airflow ────────────────────────────────────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_fernet_key_here
AIRFLOW_SECRET_KEY=your_secret_key_here
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com
# Linux users: run `echo "AIRFLOW_UID=$(id -u)" >> .env`
AIRFLOW_UID=50000

# ── Stock API secrets ──────────────────────────────────────────────────────
STOCK_API_KEY=your_stock_api_key_here
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
POLYGON_API_KEY=your_polygon_key_here
DATABASE_URL=your_database_url_here
NOTIFICATION_EMAIL=your_email_here
SLACK_WEBHOOK_URL=your_slack_webhook_here

# ── Screener configuration ─────────────────────────────────────────────────
SCREENER_TICKERS=AAPL,MSFT,GOOGL,AMZN,NVDA,TSLA,META,BRK-B,JPM,JNJ,V,UNH,XOM,MA,HD
SCREENER_PERIOD=1y
ATH_LOOKBACK_DAYS=252
RSI_PERIOD=14
MA_SHORT=50
MA_LONG=200

# ── Data pipeline paths ────────────────────────────────────────────────────
DATA_LAKE_PATH=/opt/airflow/data/lake
WAREHOUSE_PATH=/opt/airflow/warehouse/stock_analytics.duckdb
DBT_PROJECT_DIR=/opt/airflow/dbt
DBT_PROFILES_DIR=/opt/airflow/dbt
DBT_TARGET=prod
